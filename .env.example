# =============================================================================
# Vezo — Exemplo de Variáveis de Ambiente (.env.example)
# Copie para `.env` na raiz do projeto e preencha apenas localmente.
# NUNCA versione `.env` ou chaves reais no Git.
# =============================================================================

# --- Qdrant (Banco Vetorial) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rotina_estudante_multimodal
# QDRANT_API_KEY=
# QDRANT_PATH=data/qdrant

# --- Embeddings (Multilíngue 384d — ver docs/MEMORY.md M-01) ---
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Backend FastAPI & Sessões Persistentes ---
API_PORT=8000
VEZO_DB_PATH=data/vezo.db
VEZO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VEZO_COOKIE_SECURE=false
VEZO_LLM_MIN_CALL_INTERVAL=0

# --- Frontend PWA (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Observabilidade MLOps (MLflow) ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Provedor LLM (Groq) — preencha apenas no .env local ---
# GROQ_API_KEY=

# --- Benchmark Cenário 1 (Zero-Shot via Ollama opcional) ---
# ZERO_SHOT_MODEL=identificador-do-modelo
# OLLAMA_HOST=http://localhost:11434

# --- Windows: caminhos opcionais para Tesseract OCR local ---
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
