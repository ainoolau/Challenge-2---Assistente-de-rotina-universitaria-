# Vezo PWA — copie para .env.local (nunca versione .env.local)

# URL da API FastAPI usada pelo navegador.
# Desenvolvimento local: uvicorn src.api.main:app --reload (porta 8000, CORS já libera localhost:3000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Proxy same-origin opcional (/api/* -> API_PROXY_TARGET), útil no deploy (#83)
# e ao testar no celular na mesma rede Wi-Fi (mantém cookie HttpOnly first-party):
#   NEXT_PUBLIC_API_URL=/api
#   API_PROXY_TARGET=http://127.0.0.1:8000
# API_PROXY_TARGET=

# Hosts/IPs da rede local permitidos em `npm run dev:lan` (Next.js 16 bloqueia
# `/_next/*` de origens fora de localhost sem esta lista). Separe por vírgula:
# ALLOWED_DEV_ORIGINS=192.168.0.100
