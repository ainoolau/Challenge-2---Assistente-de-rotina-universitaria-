{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ainoolau/Challenge-2---Assistente-de-rotina-universitaria-/tests/benchmark_result_schema.json",
  "title": "Vezo — Contrato de resultados do benchmark LLM vs RAG (EPIC-S3-01)",
  "description": "Contrato compartilhado pelos quatro cenários. Cada cenário exporta UM arquivo (reports/scenarios/<scenario>_results.json) que valida contra a raiz deste schema. O Golden Set (tests/benchmark_llm_rag_queries.json) valida contra $defs/golden_set. Convenção de valores não aplicáveis: null = métrica/campo que não se aplica ao cenário ou não foi produzido; [] = lista sem itens; 0 = aplicável, mas nada foi consumido (ex.: tokens quando o guardrail bloqueia a chamada ao LLM).",
  "x-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "golden_set_version",
    "scenario",
    "run_id",
    "generated_at",
    "config",
    "results"
  ],
  "properties": {
    "contract_version": {
      "description": "Versão deste contrato usada na exportação.",
      "const": "1.0.0"
    },
    "golden_set_version": {
      "description": "Campo 'version' do Golden Set executado. O benchmark final (TASK-S3-05) rejeita arquivos com versão diferente da congelada.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.]+)?$"
    },
    "scenario": { "$ref": "#/$defs/scenario_id" },
    "run_id": {
      "description": "Identificador único da execução (ex.: 'naive_rag-20261112T1530Z').",
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "description": "Data/hora da exportação em ISO 8601 com fuso (ex.: '2026-11-12T15:30:00-03:00').",
      "type": "string",
      "format": "date-time"
    },
    "config": { "$ref": "#/$defs/run_config" },
    "results": {
      "description": "Um resultado por pergunta do Golden Set (12), na mesma ordem do Golden Set.",
      "type": "array",
      "items": { "$ref": "#/$defs/result" },
      "minItems": 1
    }
  },

  "allOf": [
    {
      "description": "O cenário de cada resultado deve ser o mesmo do arquivo.",
      "if": { "properties": { "scenario": { "const": "zero_shot" } } },
      "then": { "properties": { "results": { "items": { "properties": { "scenario": { "const": "zero_shot" } } } } } }
    },
    {
      "if": { "properties": { "scenario": { "const": "retrieval_only" } } },
      "then": { "properties": { "results": { "items": { "properties": { "scenario": { "const": "retrieval_only" } } } } } }
    },
    {
      "if": { "properties": { "scenario": { "const": "naive_rag" } } },
      "then": { "properties": { "results": { "items": { "properties": { "scenario": { "const": "naive_rag" } } } } } }
    },
    {
      "if": { "properties": { "scenario": { "const": "guardrail_rag" } } },
      "then": { "properties": { "results": { "items": { "properties": { "scenario": { "const": "guardrail_rag" } } } } } }
    }
  ],

  "$defs": {
    "scenario_id": {
      "description": "Identificadores padronizados: zero_shot = Cenário 1 (LLM puro, TASK-S3-02); retrieval_only = Cenário 2 (Qdrant puro, Sprint 2); naive_rag = Cenário 3 (TASK-S3-03); guardrail_rag = Cenário 4 (TASK-S3-04).",
      "type": "string",
      "enum": ["zero_shot", "retrieval_only", "naive_rag", "guardrail_rag"]
    },

    "query_id": {
      "type": "string",
      "pattern": "^GS-\\d{2}$"
    },

    "nullable_ms": {
      "type": ["number", "null"],
      "minimum": 0
    },

    "nullable_tokens": {
      "type": ["integer", "null"],
      "minimum": 0
    },

    "run_config": {
      "description": "Configuração da execução, necessária para reprodutibilidade. Campos não aplicáveis ao cenário = null.",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "llm_model",
        "llm_provider",
        "temperature",
        "max_output_tokens",
        "prompt_template_id",
        "qdrant_collection",
        "embedding_model",
        "top_k",
        "guardrail_threshold"
      ],
      "properties": {
        "llm_model": { "type": ["string", "null"], "description": "null apenas em retrieval_only." },
        "llm_provider": { "type": ["string", "null"], "description": "Ex.: groq, openai, gemini, openrouter, ollama. null apenas em retrieval_only." },
        "temperature": { "type": ["number", "null"], "minimum": 0 },
        "max_output_tokens": { "type": ["integer", "null"], "minimum": 1 },
        "prompt_template_id": {
          "type": ["string", "null"],
          "description": "Identificador do template de prompt. naive_rag e guardrail_rag devem usar o mesmo template RAG (EPIC §6.3)."
        },
        "qdrant_collection": { "type": ["string", "null"], "description": "Esperado: rotina_estudante_multimodal. null em zero_shot." },
        "embedding_model": { "type": ["string", "null"], "description": "Encoder MiniLM 384d usado na coleção. null em zero_shot." },
        "top_k": { "type": ["integer", "null"], "minimum": 1, "description": "Esperado: 3. null em zero_shot." },
        "guardrail_threshold": { "type": ["number", "null"], "description": "Limiar de similaridade (inicial 0,50). Preenchido apenas em guardrail_rag." },
        "notes": { "type": ["string", "null"] }
      }
    },

    "retrieved_chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "source", "chunk_index", "task_type", "score", "text"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "point_id": { "type": ["string", "integer", "null"], "description": "ID do ponto no Qdrant, quando disponível." },
        "source": {
          "type": "string",
          "description": "Nome do arquivo de origem (basename), ex.: 'edital_residencia_02.pdf'. Use Path(payload['source']).name."
        },
        "chunk_index": { "type": ["integer", "null"], "minimum": 0 },
        "task_type": {
          "type": ["string", "null"],
          "enum": ["texto", "ocr", "audio", null],
          "description": "Modalidade gravada na ingestão (payload task_type)."
        },
        "score": { "type": "number", "description": "Similaridade de cosseno retornada pelo Qdrant (maior = mais relevante)." },
        "text": { "type": "string" }
      }
    },

    "guardrail": {
      "description": "Decisão do guardrail. Obrigatório (objeto) em guardrail_rag; null nos demais cenários.",
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "top_score", "decision", "llm_called"],
      "properties": {
        "threshold": { "type": "number" },
        "top_score": { "type": ["number", "null"], "description": "Score do chunk mais relevante; null se nenhum chunk foi retornado." },
        "decision": { "type": "string", "enum": ["allowed", "blocked"] },
        "llm_called": { "type": "boolean", "description": "false quando a chamada ao LLM foi evitada." },
        "reason": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "blocked" } } },
          "then": { "properties": { "llm_called": { "const": false } } }
        },
        {
          "if": { "properties": { "decision": { "const": "allowed" } } },
          "then": { "properties": { "llm_called": { "const": true } } }
        }
      ]
    },

    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": { "type": "string", "description": "Ex.: 'TimeoutError', 'RateLimitError', 'QdrantUnavailable'." },
        "message": { "type": "string" }
      }
    },

    "result": {
      "description": "Resultado de UMA pergunta em UM cenário. Todos os campos são obrigatórios; os não aplicáveis usam null ou [].",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "scenario",
        "model",
        "provider",
        "answer",
        "retrieved_chunks",
        "sources",
        "retrieval_scores",
        "retrieval_latency_ms",
        "generation_latency_ms",
        "total_latency_ms",
        "input_tokens",
        "output_tokens",
        "abstained",
        "status",
        "error"
      ],
      "properties": {
        "query_id": { "$ref": "#/$defs/query_id" },
        "scenario": { "$ref": "#/$defs/scenario_id" },
        "model": { "type": ["string", "null"], "description": "LLM usado. null em retrieval_only." },
        "provider": { "type": ["string", "null"], "description": "Provedor do LLM. null em retrieval_only." },
        "answer": {
          "type": ["string", "null"],
          "description": "Texto entregue ao estudante. null em retrieval_only e quando status != success. Em abstenção, conter a mensagem padronizada."
        },
        "retrieved_chunks": {
          "type": "array",
          "items": { "$ref": "#/$defs/retrieved_chunk" },
          "description": "Chunks na ordem de rank. [] em zero_shot."
        },
        "sources": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "naive_rag/guardrail_rag: arquivos (basename) citados na resposta. retrieval_only: arquivos dos chunks recuperados, deduplicados, em ordem de rank. zero_shot: [] (não há documentos) — eventuais citações inventadas pelo modelo ficam apenas no texto da resposta e contam como alucinação."
        },
        "retrieval_scores": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Scores alinhados a retrieved_chunks (mesmo tamanho e ordem). [] em zero_shot."
        },
        "retrieval_latency_ms": { "$ref": "#/$defs/nullable_ms", "description": "null em zero_shot." },
        "generation_latency_ms": { "$ref": "#/$defs/nullable_ms", "description": "null em retrieval_only e quando o LLM não foi chamado (guardrail bloqueou)." },
        "total_latency_ms": { "$ref": "#/$defs/nullable_ms", "description": "Tempo ponta a ponta da pergunta. null apenas se status = error antes de qualquer medição." },
        "input_tokens": { "$ref": "#/$defs/nullable_tokens", "description": "null em retrieval_only ou se o provedor não informar; 0 quando o guardrail bloqueou o LLM." },
        "output_tokens": { "$ref": "#/$defs/nullable_tokens", "description": "Mesma regra de input_tokens." },
        "abstained": {
          "type": ["boolean", "null"],
          "description": "true se a resposta recusou responder por falta de evidência/conhecimento. null em retrieval_only (não gera resposta). Em zero_shot/naive_rag, o script marca true quando o modelo declina explicitamente; a TASK-S3-05 pode revisar manualmente."
        },
        "guardrail": {
          "description": "Opcional fora de guardrail_rag (null); obrigatório em guardrail_rag.",
          "oneOf": [{ "$ref": "#/$defs/guardrail" }, { "type": "null" }]
        },
        "status": { "type": "string", "enum": ["success", "error", "timeout"] },
        "error": {
          "description": "null quando status = success.",
          "oneOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }]
        },
        "extra": {
          "type": "object",
          "description": "Espaço livre para campos específicos do cenário (ex.: prompt renderizado, custo estimado). Não é usado no cálculo das métricas oficiais."
        }
      },

      "allOf": [
        {
          "$comment": "retrieval_scores deve ter o mesmo tamanho de retrieved_chunks (checado no teste de integridade; JSON Schema não compara tamanhos)."
        },
        {
          "$comment": "status success → error null; status != success → error obrigatório e answer null.",
          "if": { "properties": { "status": { "const": "success" } } },
          "then": { "properties": { "error": { "type": "null" } } },
          "else": {
            "properties": {
              "error": { "$ref": "#/$defs/error" },
              "answer": { "type": "null" }
            }
          }
        },
        {
          "$comment": "Cenário 1 — zero_shot: sem retrieval.",
          "if": { "properties": { "scenario": { "const": "zero_shot" } } },
          "then": {
            "properties": {
              "model": { "type": "string" },
              "provider": { "type": "string" },
              "retrieved_chunks": { "maxItems": 0 },
              "retrieval_scores": { "maxItems": 0 },
              "sources": { "maxItems": 0 },
              "retrieval_latency_ms": { "type": "null" },
              "guardrail": { "type": "null" }
            }
          }
        },
        {
          "$comment": "Cenário 2 — retrieval_only: sem geração (sem LLM, sem resposta, sem tokens, sem abstenção).",
          "if": { "properties": { "scenario": { "const": "retrieval_only" } } },
          "then": {
            "properties": {
              "model": { "type": "null" },
              "provider": { "type": "null" },
              "answer": { "type": "null" },
              "generation_latency_ms": { "type": "null" },
              "input_tokens": { "type": "null" },
              "output_tokens": { "type": "null" },
              "abstained": { "type": "null" },
              "guardrail": { "type": "null" }
            }
          }
        },
        {
          "$comment": "Cenário 3 — naive_rag: retrieval Top-3 + LLM sempre chamado.",
          "if": { "properties": { "scenario": { "const": "naive_rag" } } },
          "then": {
            "properties": {
              "model": { "type": "string" },
              "provider": { "type": "string" },
              "retrieved_chunks": { "maxItems": 3 },
              "retrieval_scores": { "maxItems": 3 },
              "guardrail": { "type": "null" }
            }
          }
        },
        {
          "$comment": "Cenário 4 — guardrail_rag: objeto guardrail obrigatório.",
          "if": { "properties": { "scenario": { "const": "guardrail_rag" } } },
          "then": {
            "required": ["guardrail"],
            "properties": {
              "model": { "type": "string" },
              "provider": { "type": "string" },
              "retrieved_chunks": { "maxItems": 3 },
              "retrieval_scores": { "maxItems": 3 },
              "guardrail": { "$ref": "#/$defs/guardrail" }
            }
          }
        },
        {
          "$comment": "Guardrail bloqueou → abstenção sem chamada ao LLM: sem latência de geração, tokens = 0.",
          "if": {
            "required": ["guardrail"],
            "properties": {
              "guardrail": {
                "type": "object",
                "required": ["decision"],
                "properties": { "decision": { "const": "blocked" } }
              }
            }
          },
          "then": {
            "properties": {
              "abstained": { "const": true },
              "generation_latency_ms": { "type": "null" },
              "input_tokens": { "const": 0 },
              "output_tokens": { "const": 0 }
            }
          }
        }
      ]
    },

    "golden_set": {
      "description": "Formato de ENTRADA (tests/benchmark_llm_rag_queries.json). Os scripts dos cenários leem APENAS queries[].query_id e queries[].question; os demais campos são gabarito e nunca devem ser enviados ao LLM (EPIC §6.2).",
      "type": "object",
      "required": ["golden_set_id", "version", "status", "queries", "evaluation_criteria", "abstention_message"],
      "properties": {
        "golden_set_id": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.]+)?$" },
        "status": { "type": "string", "enum": ["draft", "release_candidate", "frozen"] },
        "abstention_message": { "type": "string", "minLength": 1 },
        "queries": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/golden_query" }
        },
        "evaluation_criteria": { "type": "object" }
      }
    },

    "golden_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "question",
        "category",
        "source_type",
        "out_of_domain",
        "expected_behavior",
        "expected_answer",
        "key_facts",
        "primary_source",
        "accepted_sources",
        "evidence",
        "expected_keywords",
        "behavior_if_no_evidence",
        "sprint2_origin"
      ],
      "properties": {
        "query_id": { "$ref": "#/$defs/query_id" },
        "question": { "type": "string", "minLength": 5 },
        "category": { "type": "string" },
        "source_type": {
          "type": "string",
          "enum": ["pdf", "audio_whisper", "image_ocr", "none"],
          "description": "Modalidade da fonte principal. 'none' apenas para pergunta fora de domínio."
        },
        "out_of_domain": { "type": "boolean" },
        "expected_behavior": { "type": "string", "enum": ["answer", "abstain"] },
        "expected_answer": { "type": "string", "minLength": 1 },
        "key_facts": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Fatos atômicos que a resposta precisa conter para ser considerada correta. [] na pergunta fora de domínio."
        },
        "primary_source": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["doc_id", "file", "location"],
          "properties": {
            "doc_id": { "type": "string", "pattern": "^DOC-\\d{2}$" },
            "file": { "type": "string" },
            "location": { "type": "string" }
          }
        },
        "accepted_sources": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Arquivos (basename) cuja citação/recuperação é considerada correta. Inclui primary_source.file."
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "location", "excerpt"],
            "properties": {
              "file": { "type": "string" },
              "location": { "type": "string" },
              "excerpt": { "type": "string", "minLength": 1 }
            }
          }
        },
        "expected_keywords": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Termos que devem aparecer no chunk da fonte correta (keyword match @3, compatível com a Sprint 2)."
        },
        "behavior_if_no_evidence": { "type": "string" },
        "sprint2_origin": {
          "type": ["string", "null"],
          "description": "Rastreabilidade para scripts/evaluate_rag.py (EVAL_DATASET), ou null se a pergunta é nova."
        },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
